{
  "kind": "collectionType",
  "collectionName": "menus",
  "info": {
    "singularName": "menu",
    "pluralName": "menus",
    "displayName": "Menu"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string"
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "makanan",
        "minuman",
        "cemilan",
        "aksesoris"
      ]
    },
    "price": {
      "type": "integer"
    },
    "stock": {
      "type": "integer"
    },
    "ketersediaan": {
      "type": "enumeration",
      "enum": [
        "tersedia",
        "habis"
      ]
    },
    "description": {
      "type": "text"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "tenant": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::home.home",
      "inversedBy": "menu"
    },
    "slug": {
      "type": "uid",
      "targetField": "name"
    }
  }
}
